{
  "name": "dorimaki",
  "version": "0.1.0",
  "description": "Your own Discord coding bot powered by the omo CLI",
  "license": "MIT",
  "type": "module",
  "bin": { "dorimaki": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "docs"],
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "commander": "^14.0.2",
    "@clack/prompts": "^0.11.0",
    "zod": "^4.1.12",
    "ky": "^1.14.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3",
    "oxlint": "^1.25.0",
    "oxfmt": "^0.16.0"
  }
}
